# Public HTTPS URL that New API redirects users to for authorization.
HKM_PUBLIC_BASE_URL=https://migration.example.com

# Use the same value as migration.shared_secret in Sub2API config.
# Generate with: openssl rand -hex 32
HKM_SHARED_SECRET=replace-with-at-least-32-random-bytes

# Reachable from the sidecar container on HKM_NEW_API_NETWORK.
HKM_DATABASE_URL=postgres://newapi:replace-me@new-api-postgres:5432/newapi?sslmode=disable

# Existing external Docker network names; discover with: docker network ls
HKM_NEW_API_NETWORK=new-api-network
HKM_SUB2API_NETWORK=sub2api-network

# Quota units per source currency unit, matching the New API deployment.
HKM_QUOTA_PER_UNIT=500000
HKM_AUTH_TTL=10m
HKM_GRANT_TTL=2h
